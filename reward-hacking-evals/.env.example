# Copy to .env and fill in. .env is gitignored.
#
# Run scripts/bootstrap_env.sh once to auto-populate the SSH_KEY_VPS* values
# from your ~/.ssh files.

# ---- Judge backend API keys ----
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-...

# ---- VPS hosts ----
SSH_HOST_VPS1=team@87.99.129.5
SSH_HOST_VPS2=team@206.189.230.132

# ---- VPS SSH private keys (full multiline contents) ----
# Populate via `bash scripts/bootstrap_env.sh` (reads from ~/.ssh/autoresearch
# and ~/.ssh/autoresearch_2). Or paste manually as triple-quoted heredoc:
#
# SSH_KEY_VPS1="-----BEGIN OPENSSH PRIVATE KEY-----
# ...key body...
# -----END OPENSSH PRIVATE KEY-----"
SSH_KEY_VPS1=
SSH_KEY_VPS2=

# ---- Modal ----
# Tokens come from ~/.modal.toml (managed by `modal token set`).
# Override the active profile here only if you need to:
# MODAL_PROFILE=spar-maded
